{
  "name": "nibble-desktop",
  "productName": "Nibble",
  "version": "0.4.0",
  "description": "Nibble 的 Windows 桌面伴生版：全局敲击空格 / 回车，像素小生物就在桌面上发起攻击",
  "main": "main.js",
  "author": "LMLuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LMLuo/nibble-desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage tar.gz",
    "dist:linux:tgz": "electron-builder --linux dir && node scripts/pack-linux-tgz.js x64",
    "dist:linux:tgz:arm64": "electron-builder --linux dir --arm64 -c.npmRebuild=false && node scripts/pack-linux-tgz.js arm64"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.lmluo.nibble-desktop",
    "productName": "Nibble",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay/**/*",
      "lib/**/*",
      "media/**/*",
      "assets/*",
      "!node_modules/uiohook-napi/build/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "Nibble-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "executableName": "nibble",
      "extraFiles": [
        {
          "from": "linux/README-Linux.txt",
          "to": "README-Linux.txt"
        }
      ],
      "category": "Utility",
      "synopsis": "敲空格 / 回车，桌面上的像素小生物向野生 Bug 发起攻击",
      "desktop": {
        "Name": "Nibble",
        "Comment": "Nibble 桌面伴生版"
      }
    },
    "appImage": {
      "artifactName": "Nibble-${version}-x86_64.AppImage"
    }
  }
}
